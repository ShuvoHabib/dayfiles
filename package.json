{
  "name": "dayfiles-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run site:build && npm run blog:build && vite build",
    "preview": "vite preview",
    "build:cf": "npm run build",
    "deploy:cf": "npm run build && npx wrangler pages deploy dist",
    "site:build": "node scripts/site/build-product-pages.mjs",
    "blog:build": "node scripts/blog/build.mjs",
    "blog:validate": "node scripts/blog/validate.mjs",
    "blog:gen:pdf-seo": "node scripts/blog/generate-pdf-seo-pack.mjs",
    "blog:gen:pdf-checklist": "node scripts/blog/generate-pdf-checklist-pack.mjs",
    "blog:gen:pdf-story": "node scripts/blog/generate-pdf-story-pack.mjs",
    "blog:test-sitemap": "node scripts/blog/test-publish-sitemap.mjs",
    "blog:scrape": "node scripts/blog/scrape-facts.mjs",
    "blog:auto": "node scripts/blog/run-auto.mjs",
    "blog:queue": "node scripts/blog/publish-queued.mjs",
    "router:test": "node --test edge-router/test/*.test.mjs",
    "router:types": "wrangler types --config wrangler.router.jsonc --env production edge-router/worker-configuration.d.ts",
    "router:dry-run": "wrangler deploy --dry-run --config wrangler.router.jsonc --env production",
    "router:deploy:staging": "wrangler deploy --config wrangler.router.jsonc --env staging",
    "router:deploy:production": "wrangler deploy --config wrangler.router.jsonc --env production"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^13.0.3",
    "openai": "^5.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260808.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@types/node": "^24.10.1",
    "vite": "^5.4.10",
    "wrangler": "4.120.0"
  }
}
